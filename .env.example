# Aghara environment variables

# --- Required ---
# Neon pooled connection string (or any Postgres).
DATABASE_URL="postgres://user:password@host:port/db-name"

# Public origin of the app (used by Better Auth + webhook redirects).
ORIGIN="http://localhost:5173"

# Better Auth secret — 32+ chars, high entropy.
BETTER_AUTH_SECRET=""

# AES-256-GCM key for channel credentials at rest — 32 bytes as 64 hex chars.
# Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=""

# "true" disables billing + all plan limits (unlimited accounts/posts/tokens).
SELF_HOST="true"

# --- Scheduler ---
# The in-process minutely tick publishes due posts and owns the status page's
# probe stream. Set to "off" for local work you don't want touching the database:
# it polls and writes, and every minute it runs keeps the Neon compute awake
# (which burns the Free plan's CU-hour allowance).
# SCHEDULER="off"

# --- Admin account (seed with `bun run seed:admin`) ---
# Creates/updates this user with role=admin + an active pro subscription (no expiry).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Optional: GitHub OAuth ---
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Optional: Paystack billing (ignored when SELF_HOST=true) ---
# Get keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# NGN plans (required)
PAYSTACK_PLAN_CREATOR="PLN_u84yri7zmwlc0bo"
PAYSTACK_PLAN_CREATOR_YEARLY="PLN_imu4qm8083amnvi"
PAYSTACK_PLAN_PRO="PLN_6e190vyu37i1i6o"
PAYSTACK_PLAN_PRO_YEARLY="PLN_021dk5hap8s0dnz"
# USD plans (optional — leave empty to hide USD option)
PAYSTACK_PLAN_CREATOR_USD=""
PAYSTACK_PLAN_CREATOR_YEARLY_USD=""
PAYSTACK_PLAN_PRO_USD=""
PAYSTACK_PLAN_PRO_YEARLY_USD=""

# --- Optional: Threads (requires Meta app review) ---
# Leave empty/off until Meta approves your app.
THREADS_ENABLED="false"
