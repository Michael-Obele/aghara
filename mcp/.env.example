# Aghara MCP — environment

# The Aghara app URL. Swap between dev and prod:
#   dev:  http://localhost:5173
#   prod: https://aghara.fly.dev
AGHARA_BASE_URL="http://localhost:5173"

# API token created in the Aghara UI (Settings → API tokens).
# Sent as `Authorization: Bearer <token>` on every REST call.
AGHARA_API_TOKEN=""

# HTTP port for the MCP server (Fly.io sets this).
PORT=8000